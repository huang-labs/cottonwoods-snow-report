{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cottonwoods-snow-report",
  // Direct Worker API and cron; static page requests bypass Worker code.
  "main": "./worker.ts",
  // Satori's font shaper needs a precompiled WASM module in workerd.
  "alias": { "harfbuzzjs": "./src/worker/harfbuzz.ts" },
  "define": { "__filename": "\"/worker.js\"", "__dirname": "\"/\"" },
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Served only on the custom domain (Cloudflare manages its DNS record and certificate).
  "routes": [{ "pattern": "cottonwoods-snow-report.huang.mx", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": true,
  "ai": { "binding": "AI" },
  "vars": {
    "AI_GATEWAY_ID": "snow-report",
    // Contact appended to the collector's User-Agent (api.weather.gov asks clients to identify themselves).
    "COLLECTOR_CONTACT": "https://cottonwoods-snow-report.huang.mx"
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/opengraph-image", "/daily-snow/opengraph-image"]
  },
  "kv_namespaces": [
    {
      "binding": "SNOW_KV",
      // Production namespace (account "Huang Inc."). Not a secret.
      "id": "25451aae36fb40b68f530ee747940440"
    }
  ],
  // One global collection cron for every source category.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
